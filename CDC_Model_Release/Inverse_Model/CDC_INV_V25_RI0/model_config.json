{
  "release_name": "CDC_INV_V25_RI0",
  "role": "residual inverse current model",
  "version": "V25-RI0",
  "frozen": true,
  "source": {
    "project": "V25 residual inverse",
    "run_dir": "D:/v25_residual/runs/V25_RI0_RESIDUAL_seed7",
    "checkpoint": "best.pth",
    "checkpoint_epoch": 130,
    "run_config": "source_run_config.json",
    "seed": 7,
    "epochs_trained": 130,
    "warm_started_from_v24_i0": false
  },
  "architecture": {
    "module": "model_def.py :: ResidualI0()",
    "gru": {
      "input_size": 31,
      "hidden_size": 8,
      "num_layers": 2,
      "batch_first": true
    },
    "skip_concat": {
      "parts": [
        "gru_output_8",
        "input_31"
      ],
      "concat_dim": 39
    },
    "trunk": {
      "layers": [
        "Linear(39,16)",
        "ReLU"
      ],
      "in_features": 39,
      "out_features": 16
    },
    "head": {
      "layers": [
        "Linear(16,1)"
      ],
      "activation": "LINEAR, no sigmoid",
      "out_features": 1
    },
    "uses_monotonic_G": false,
    "uses_tau": false
  },
  "parameters": {
    "total": 2073,
    "gru": 1416,
    "trunk": 640,
    "head": 17
  },
  "io": {
    "input": "x (B,T,31) = motion[20] + condition[11] at 100 Hz",
    "output": "delta current in A, unbounded, may be negative",
    "equation": "I_cmd[k] = clip(I_meas_100Hz[k-1] + delta[k], 0.0, 1.6)",
    "residual_base": "I_meas_100Hz[k-1] = clip(|I_measured_decimated[k-1]|,0,1.6) A",
    "history": "one control step (10 ms) of past current; no fixed window; zero GRU state and zero base at every file start"
  },
  "metrics": {
    "mae_A": 0.030007,
    "rmse_A": 0.066758,
    "p95_A": 0.138436,
    "p99_A": 0.316785,
    "pooled_nrmse_pct": 9.2948,
    "per_condition_mae_A": {
      "SH": 0.0069,
      "ST": 0.0182,
      "RLF": 0.0434,
      "SR": 0.0071,
      "RHF": 0.0698
    },
    "zero_current_pred_mean_A": 0.0097,
    "false_turn_on_rate": 0.0325,
    "raw_out_of_range_rate": 0.0805,
    "clip_activation_rate": 0.0805
  },
  "files": {
    "model_def": "model_def.py",
    "feature_def": "feature_def.py",
    "normalization": "normalization.json",
    "feature_spec": "feature_spec.json",
    "fir": "fir_61tap_40hz.json",
    "training_artifacts": "training_artifacts/ (逐轮 metrics.jsonl + 诊断 CSV/JSON + figures，只读追溯用)",
    "golden_vectors": "golden_vectors.npz + golden_vectors_meta.json"
  }
}